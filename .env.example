# ---- Telegram (obrigatorio) ----
TELEGRAM_TOKEN=
# ID do canal/grupo de destino (-100... para canais). O bot precisa ser
# administrador com permissao "Publicar mensagens".
TELEGRAM_CHAT_ID=
# Seu user id do Telegram, para o bot te avisar no privado quando NAO publicar
# uma oferta (ex.: o gerador oficial de link de afiliado falhou).
ADMIN_CHAT_ID=

# ---- Afiliados (o link publicado vem do GERADOR OFICIAL da loja) ----
# O bot nao anexa mais ?matt_word/?tag na URL: ele abre o portal de afiliado
# no Chrome logado e publica o link curto gerado la. Sem o link do gerador a
# oferta NAO e publicada e voce recebe um aviso no privado.
# Faca o login uma unica vez:  python bot.py --login-browser
#
# Mercado Livre: etiqueta de afiliado da sua conta.
ML_AFFILIATE_TAG=
# Aceito como fallback da etiqueta do ML:
ML_MATT_WORD=
# Shopee: credenciais da Open API de afiliados.
# Com estas duas chaves o bot busca ofertas e gera links pela Open API,
# sem passar pelo site/portal (e sem cair na tela de anti-bot).
SHOPEE_APP_ID=
SHOPEE_SECRET=
# Amazon: tag do Amazon Associados (usada dentro do SiteStripe).
AMAZON_TAG=
# Marketplace BR da Amazon (nao mude sem motivo).
AMAZON_MARKETPLACE_ID=A2Q3Y263D00KWC

# ---- Fontes ----
SOURCE_CHANNELS=@linksBrazil,@xetdaspromocoes
SEARCH_TERMS=
SHEET_CSV_URL=
# Ofertas do portal Shopee (affiliate.shopee.com.br/offer/product_offer) por
# ciclo. Cada uma abre o modal "Obter link" no Chrome logado. Default: 6.
SHOPEE_OFFER_LIMIT=6

# ---- Lojas do Mercado Livre usadas como fonte de ofertas ----
# O /ofertas do ML esta atras do bot-wall e so responde com Chrome de verdade.
# Ja as paginas /social/<loja> respondem sempre, com preco e titulo.
# Coloque aqui o nome da sua loja e a de quem voce tem autorizacao:
#   ML_STORES=SEUUSUARIO,outruloja
# Se ficar vazio, o bot usa apenas as lojas que aprendeu nos links de canal.
ML_STORES=

# Resolvedor de link curto (meli.la, shope.ee, amzn.to, tidd.ly...).
# 1 = expande o link e acha o produto dentro da loja. 0 = so avisa.
RESOLVE_STORE_LINKS=1

# Link de LOJA do Mercado Livre (/social/) ignora a tag de afiliado. Com 1 o bot
# le o catalogo da loja e tenta achar o produto pelo preco/titulo para publicar
# o link de verdade. Com 0 ele so avisa que o link nao gera comissao.
RESOLVE_STORE_LINKS=1

# ---- Instagram ----
IG_ACCESS_TOKEN=
IG_USER_ID=
BLOB_READ_WRITE_TOKEN=

# ---- Telethon (monitoramento dos canais) ----
API_ID=
API_HASH=

# ---- Rede ----
# Sem proxy o Mercado Livre e a Shopee costumam bloquear este IP.
PROXY=

# O ML devolve "suspicious-traffic" para requests, curl_cffi e ate para o Chrome
# headless. So um Chrome com JANELA DE VERDADE passa — por isso o Selenium.
# USE_SELENIUM=0 desliga (o bot volta a raspar so o que nao for bloqueado).
USE_SELENIUM=1
# 0 = janela de verdade (necessario para o ML liberar). Só use 1 em testes.
SELENIUM_HEADLESS=0

# ---- Navegador persistente ----
# Login dos portais de afiliado + raspagem feitos no Chrome real.
BROWSER_SCRAPING=1
# Pasta do perfil (cookies/login). Vazio = .browser-profile ao lado do bot.
BROWSER_PROFILE_DIR=
# Tempo maximo (segundos) para o gerador de link responder.
LINK_GEN_TIMEOUT=60

# ---- Ritmo ----
INTERVAL_TELEGRAM=3600
INTERVAL_INSTAGRAM=10800
POSTS_PER_CYCLE=2
# Instagram: quantos posts por ciclo (o ciclo roda a cada INTERVAL_INSTAGRAM,
# ou seja, 2 posts a cada 3h por padrao) e pausa em segundos entre eles.
IG_POSTS_PER_CYCLE=2
IG_POST_DELAY=30

# ---- Cupons do Mercado Livre ----
# O ciclo do Telegram também busca os cupons ativos em /ofertas/cupons e
# publica no grupo somente os que ainda não foram enviados. Estes dois
# controles valem para o ciclo automático e para o comando /cupons.
CUPOM_POSTS_PER_CYCLE=3
CUPOM_DELAY=5

# ---- Filtro de oferta ----
# Descarta preco absurdo (shampoo de 24.000, console de 5.000) para so
# entrar promocao de verdade. Use 0 para desligar cada faixa.
MIN_PRICE=15
MAX_PRICE=2500
# Desconto minimo em % para exigir promocao. 0 = aceita sem desconto.
# Em loja do ML o preco antigo nem sempre vem, entao 0 e o recomendado.
MIN_DISCOUNT=0
# Instagram: so entra na fila se o desconto real for >= N%. Sem preco antigo
# nao da para medir e a oferta fica de fora. 0 = desliga (posta tudo com imagem).
IG_MIN_DISCOUNT=20

FOOTER=🔗 Links afiliados. Gostou da oferta? Compartilhe nosso grupo: https://t.me/vagantepromo